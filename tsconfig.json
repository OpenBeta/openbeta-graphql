{
  "compilerOptions": {
    "rootDirs": [
      "src"
    ],
    "baseUrl": "./src",
    "paths": {
      "@gql": [
        "./gql/generated/graphql.ts"
      ],
      "@db": [
        "./db"
      ],
      "@schema": [
        "./db/schema/index.ts"
      ]
    },
    "outDir": "dist",
    "lib": [
      "es2023"
    ],
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "strict": true,
    "allowJs": false,
    "skipLibCheck": true
  },
  "exclude": [
    "src.mongo"
  ]
}
